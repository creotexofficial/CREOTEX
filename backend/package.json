{
  "name": "creotex-shop-backend",
  "version": "1.0.0",
  "description": "Backend API for CreotexShop Robotics & Electronics E-Commerce Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "build": "echo \"Backend build not required\"",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeder.js",
    "seed:destroy": "node seeder.js -d",
    "sync:catalog": "node scripts/syncCatalogToDB.js",
    "list:products": "node scripts/listProducts.js"
  },
  "keywords": [
